{
  "rules": {
    ".write": "auth != null",
    ".read": "auth != null",
    "public": {
      ".read": true,
      ".write": false,
      "web_data": {
        ".read": true,
        ".write": false
      },
      "team_hillary": {
        ".read": true,
        ".write": true
      }
    },
    "market_share_providers": {
      ".read": true,
      ".write": "auth != null"
    },
    "market_share_payers": {
      ".read": true,
      ".write": "auth != null"
    },
    "examples": {
      ".read": true,
      ".write": "auth != null"
    },
    "ambulatorydata": {
      "nytest": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "users": {
      ".read": "auth != null && (auth.token.email.endsWith('@careluminate.com') || auth.token.email.endsWith('@healthluminate.com'))",
      ".write": "auth != null && (auth.token.email.endsWith('@careluminate.com') || auth.token.email.endsWith('@healthluminate.com'))"
    },
    "phone_activities": {
      ".read": "auth != null && (auth.token.email.endsWith('@careluminate.com') || auth.token.email.endsWith('@healthluminate.com'))",
      ".write": "auth != null && (auth.token.email.endsWith('@careluminate.com') || auth.token.email.endsWith('@healthluminate.com'))"
    },
    "cl": {
      "financial_forecast": {
        ".read": "auth != null && (auth.token.email.endsWith('@careluminate.com') || auth.token.email.endsWith('@healthluminate.com'))",
        ".write": "auth != null && (auth.token.email.endsWith('@careluminate.com') || auth.token.email.endsWith('@healthluminate.com'))"
      }
    },
    "kba": {
      "rfp_bulk_jobs": {
        ".indexOn": "status"
      }
    }
  }
} 
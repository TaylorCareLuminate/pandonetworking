{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://careluminate.com/schemas/connect_analysis.schema.json",
  "title": "ConnectAnalysisPayload",
  "description": "Weekly LinkedIn outreach success analysis published to Firebase at ConnectAnalysis/latest and ConnectAnalysis/runs/<YYYY-MM-DD>. Produced by 'Connect Success Model v1.R'.",
  "type": "object",
  "required": ["meta", "overall", "model_quality", "clients"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "#/definitions/Meta" },
    "overall": { "$ref": "#/definitions/Segment" },
    "model_quality": { "$ref": "#/definitions/ModelQuality" },
    "clients": {
      "type": "object",
      "description": "Keyed by URL-safe client slug (e.g. 'blue_goat_cyber'). Each value is a Segment plus a hypothesis_groups map.",
      "additionalProperties": { "$ref": "#/definitions/ClientSegment" }
    }
  },
  "definitions": {
    "Meta": {
      "type": "object",
      "required": ["generated_at", "run_date", "source_file", "n_contacts", "n_clients", "blend_weights", "ai_scored"],
      "additionalProperties": false,
      "properties": {
        "generated_at": { "type": "string", "description": "ISO-8601 local timestamp the run was generated." },
        "run_date": { "type": "string", "description": "Run tag / date, format YYYY-MM-DD." },
        "source_file": { "type": "string", "description": "Basename of the input export (xlsx/csv/json)." },
        "n_contacts": { "type": "integer" },
        "n_clients": { "type": "integer" },
        "blend_weights": {
          "type": "object",
          "description": "Weights used to compute blended_score from the three funnel rates.",
          "required": ["connected", "replied", "scheduled"],
          "properties": {
            "connected": { "type": "number" },
            "replied": { "type": "number" },
            "scheduled": { "type": "number" }
          }
        },
        "ai_scored": { "type": "boolean", "description": "Whether AI feature scoring was run for this payload." }
      }
    },

    "ModelQuality": {
      "type": "object",
      "required": ["n_total", "rf_fitted", "top_drivers"],
      "additionalProperties": false,
      "properties": {
        "n_total": { "type": "integer" },
        "rf_fitted": {
          "type": "array",
          "description": "Which outcomes had a random-forest model successfully fitted.",
          "items": { "type": "string", "enum": ["connected", "replied", "scheduled"] }
        },
        "top_drivers": {
          "type": "array",
          "description": "Strongest predictive features per outcome (internal snake_case feature names; humanize for display).",
          "items": {
            "type": "object",
            "required": ["feature", "importance", "outcome"],
            "additionalProperties": false,
            "properties": {
              "feature": { "type": "string" },
              "importance": { "type": ["number", "null"] },
              "outcome": { "type": "string" }
            }
          }
        }
      }
    },

    "ClientSegment": {
      "description": "A client-level Segment that also carries its hypothesis groups.",
      "allOf": [
        { "$ref": "#/definitions/Segment" },
        {
          "type": "object",
          "properties": {
            "hypothesis_groups": {
              "type": "object",
              "description": "Keyed by URL-safe hypothesis-group slug.",
              "additionalProperties": { "$ref": "#/definitions/Segment" }
            }
          }
        }
      ]
    },

    "Segment": {
      "type": "object",
      "description": "Core analysis unit. When sufficient_data is false, only funnel, trend and note are present.",
      "required": ["name", "id", "funnel", "trend", "sufficient_data"],
      "properties": {
        "name": { "type": "string" },
        "id": { "type": ["string", "null"], "description": "'overall', a hypothesis_group_id, or a slug." },
        "sufficient_data": { "type": "boolean", "description": "False when segment has < min_segment_n (40) contacts; keys/research/examples omitted." },
        "note": { "type": "string", "description": "Present only when sufficient_data is false." },
        "funnel": { "$ref": "#/definitions/Funnel" },
        "trend": { "type": "array", "items": { "$ref": "#/definitions/TrendPoint" } },
        "keys": { "$ref": "#/definitions/Keys" },
        "research": { "$ref": "#/definitions/Research" },
        "examples": { "$ref": "#/definitions/Examples" },
        "message_prompt": {
          "type": "string",
          "description": "AI-generated, ready-to-use prompt for writing new outreach messages tuned to what works for this exact segment (built from its funnel, keys, top-performing dimension levels, and winning example messages). Present only when build_prompts was enabled for the run and this segment had sufficient_data; render as a copyable block (e.g. a 'Generate messages for this segment' box with a copy-to-clipboard button)."
        },
        "hypothesis_groups": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/Segment" }
        }
      }
    },

    "Funnel": {
      "type": "object",
      "description": "All *_rate values are percentages already (22.3 == 22.3%).",
      "required": ["n"],
      "properties": {
        "n": { "type": "integer" },
        "connected": { "type": "integer" },
        "replied": { "type": "integer" },
        "scheduled": { "type": "integer" },
        "connect_rate": { "type": ["number", "null"], "description": "% of contacts who accepted the connection." },
        "reply_rate": { "type": ["number", "null"], "description": "% who replied." },
        "meeting_rate": { "type": ["number", "null"], "description": "% who scheduled a meeting (2 decimals)." },
        "cond_reply_rate": { "type": ["number", "null"], "description": "% of connected who replied." },
        "cond_meeting_rate": { "type": ["number", "null"], "description": "% of replied who scheduled." },
        "blended_score": { "type": ["number", "null"], "description": "Headline KPI: 0.15*connect_rate + 0.35*reply_rate + 0.50*meeting_rate." }
      }
    },

    "TrendPoint": {
      "type": "object",
      "required": ["month"],
      "additionalProperties": false,
      "properties": {
        "month": { "type": "string", "description": "YYYY-MM." },
        "n": { "type": "integer" },
        "connect_rate": { "type": ["number", "null"] },
        "reply_rate": { "type": ["number", "null"] },
        "meeting_rate": { "type": ["number", "null"] }
      }
    },

    "Keys": {
      "type": "object",
      "required": ["working", "not_working"],
      "additionalProperties": false,
      "properties": {
        "working": { "type": "array", "items": { "$ref": "#/definitions/KeyItem" } },
        "not_working": { "type": "array", "items": { "$ref": "#/definitions/KeyItem" } }
      }
    },

    "KeyItem": {
      "type": "object",
      "description": "A tested success signal. effect_pp is connection-adjusted and empirical-Bayes-shrunk, in percentage points.",
      "required": ["label", "category", "outcome", "effect_pp", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "category": { "type": "string" },
        "outcome": { "type": "string", "enum": ["connected", "replied", "scheduled"] },
        "effect_pp": { "type": ["number", "null"], "description": "Connection-adjusted, shrunk change in outcome rate (percentage points). Show as +/- pp." },
        "overall_effect_pp": { "type": ["number", "null"], "description": "Same effect measured across all data (benchmark)." },
        "rate_with": { "type": ["number", "null"], "description": "Outcome rate (%) when the signal is present." },
        "rate_without": { "type": ["number", "null"], "description": "Outcome rate (%) when the signal is absent." },
        "n_with": { "type": ["integer", "null"] },
        "n_without": { "type": ["integer", "null"] },
        "p_value": { "type": ["number", "null"] },
        "connection_controlled": { "type": ["boolean", "null"], "description": "Adjusted for the prospect's LinkedIn connection count." },
        "confidence": { "type": "string", "enum": ["High", "Medium", "Low"] }
      }
    },

    "RateRow": {
      "type": "object",
      "description": "A breakdown row: outcome rates for one level of a dimension.",
      "required": ["level", "n"],
      "additionalProperties": false,
      "properties": {
        "level": { "type": "string" },
        "n": { "type": "integer" },
        "connect_rate": { "type": ["number", "null"] },
        "reply_rate": { "type": ["number", "null"] },
        "meeting_rate": { "type": ["number", "null"] }
      }
    },

    "Research": {
      "type": "object",
      "description": "Deep-dive breakdowns. Most fields are arrays of RateRow. Segments with sufficient_data=false omit this object.",
      "properties": {
        "company_vs_prospect": { "$ref": "#/definitions/CompanyVsProspect" },
        "ai_feel": { "$ref": "#/definitions/AiFeel" },
        "reason_to_connect": { "type": "array", "items": { "$ref": "#/definitions/RateRow" } },
        "hook_type": { "type": "array", "items": { "$ref": "#/definitions/RateRow" } },
        "tone": { "type": "array", "items": { "$ref": "#/definitions/RateRow" } },
        "question_type": { "type": "array", "items": { "$ref": "#/definitions/RateRow" } },
        "opener_type": { "type": "array", "items": { "$ref": "#/definitions/RateRow" } },
        "message_type": { "type": "array", "items": { "$ref": "#/definitions/RateRow" } },
        "message_length": {
          "type": "array",
          "description": "25-character bands, always in ascending chronological order (do not re-sort): '1-25', '26-50', '51-75', '76-100', '101-125', '126-150', '151-175', '176-200', '201-225', '226-250', '251+'. With 11 bins, high-character buckets can be low-n in narrow client/hypothesis-group segments — render as an ordered bar chart and consider de-emphasizing low-n bars.",
          "items": { "$ref": "#/definitions/RateRow" }
        },
        "readability": { "type": "array", "items": { "$ref": "#/definitions/RateRow" } },
        "personal_sharing": {
          "type": "array",
          "description": "AI-scored: how specific the personal detail the sender shares about themselves is. 3 levels, in this order: 'Unique' (a distinctive personal detail/shared experience), 'Generic' (a vague claim anyone could make), 'None' (nothing personal). New field — blank/absent until a full AI re-scan has been run.",
          "items": { "$ref": "#/definitions/RateRow" }
        },
        "connect_phrasing": {
          "type": "array",
          "description": "Regex-based (non-AI) classification of how the first message phrases its connect request. Levels: 'Let's connect', 'Worth connecting', 'Would love to connect', 'Open to connecting', 'Happy to connect', 'Would like to connect', 'Other connect ask', 'No connect ask'. Populates retroactively on any normal model re-run (no AI re-scan needed).",
          "items": { "$ref": "#/definitions/RateRow" }
        },
        "exclamation_use": {
          "type": "array",
          "description": "Regex-based count of '!' in the first message. 3 levels, in this order: 'None', 'One', 'Multiple (2+)'.",
          "items": { "$ref": "#/definitions/RateRow" }
        },
        "emoji_use": {
          "type": "array",
          "description": "Regex-based count of emoji (including flags) in the first message. 3 levels, in this order: 'None', 'One', 'Multiple (2+)'.",
          "items": { "$ref": "#/definitions/RateRow" }
        },
        "abbreviation_use": {
          "type": "array",
          "description": "Whether the first message uses informal/texting shorthand (lol, btw, fyi, asap, etc — word-boundary matched, excludes standard business abbreviations). 2 levels: 'Uses abbreviations', 'No abbreviations'.",
          "items": { "$ref": "#/definitions/RateRow" }
        },
        "day_of_week": { "type": "array", "items": { "$ref": "#/definitions/RateRow" } },
        "time_of_day": {
          "type": "array",
          "description": "Exactly 6 levels, always in chronological order (do not re-sort): 'Early morning (5-8a)', 'Morning (9-11a)', 'Afternoon (12-2p)', 'Late afternoon (3-5p)', 'Evening (6-9p)', 'Overnight (10p-4a)'. Times are US Central.",
          "items": { "$ref": "#/definitions/RateRow" }
        },
        "day_time": {
          "type": "array",
          "description": "Day x time-of-day cross, up to 42 rows (7 days x 6 parts). level = '{Day} {Part}' (e.g. 'Monday Afternoon'), where Part matches time_of_day's levels minus the parenthetical time range. Many rows are low-n; render as a heatmap or filter by a minimum n before treating as meaningful.",
          "items": { "$ref": "#/definitions/RateRow" }
        },
        "request_day_of_week": {
          "type": "array",
          "description": "Same shape/levels as day_of_week (weekday name, Monday-Sunday), but built from conn_request_sent — when the connection request was actually SENT (US Central) — rather than first-message/outreach dates, which mostly track acceptance/reply timing. This is the true 'when should the invite land?' signal. Rank/sort by connect_rate (acceptance), not reply_rate, since that's the outcome send-time actually influences. Empty/absent if conn_request_sent wasn't available for this segment — fall back to day_of_week.",
          "items": { "$ref": "#/definitions/RateRow" }
        },
        "request_time_of_day": {
          "type": "array",
          "description": "Same shape/levels as time_of_day (6 US-Central buckets, chronological), but built from conn_request_sent — the actual request-send moment — rather than first-message/outreach dates. Rank/sort by connect_rate, not reply_rate. Empty/absent if conn_request_sent wasn't available for this segment — fall back to time_of_day.",
          "items": { "$ref": "#/definitions/RateRow" }
        },
        "request_day_time": {
          "type": "array",
          "description": "Same shape as day_time (level = '{Day} {Part}', up to 42 rows), but built from conn_request_sent instead of first-message dates. Rank/sort by connect_rate, not reply_rate. Empty/absent if conn_request_sent wasn't available for this segment — fall back to day_time.",
          "items": { "$ref": "#/definitions/RateRow" }
        },
        "by_connections": { "type": "array", "items": { "$ref": "#/definitions/RateRow" } },
        "total_messages": { "type": "array", "items": { "$ref": "#/definitions/RateRow" } },
        "audience_seniority": { "type": "array", "items": { "$ref": "#/definitions/RateRow" } },
        "audience_org_type": { "type": "array", "items": { "$ref": "#/definitions/RateRow" } },
        "bdr_performance": { "type": "array", "items": { "$ref": "#/definitions/RateRow" } },
        "top_phrases": { "$ref": "#/definitions/TopPhrases" },
        "key_phrases": { "$ref": "#/definitions/KeyPhrases" },
        "followup": { "$ref": "#/definitions/FollowupBlock" },
        "style_examples": { "$ref": "#/definitions/StyleExamples" }
      }
    },

    "StyleExamples": {
      "type": "object",
      "description": "Real messages behind every research breakdown dimension. Each key is an array of per-level rows (same array-of-rows shape as every other research breakdown), matched to that dimension's rate-table row by raw level/key (for ai_feel: stringified ai_score; for company_vs_prospect: bucket). Optional — omitted when there weren't enough captured examples.",
      "additionalProperties": false,
      "properties": {
        "tone": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "hook_type": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "reason_to_connect": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "opener_type": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "question_type": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "message_type": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "message_length": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "readability": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "personal_sharing": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "connect_phrasing": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "exclamation_use": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "emoji_use": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "abbreviation_use": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "day_of_week": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "time_of_day": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "day_time": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "request_day_of_week": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "request_time_of_day": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "request_day_time": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "by_connections": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "total_messages": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "audience_seniority": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "audience_org_type": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "bdr_performance": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "ai_feel": { "$ref": "#/definitions/StyleExampleLevelArray" },
        "company_vs_prospect": { "$ref": "#/definitions/StyleExampleLevelArray" }
      }
    },

    "StyleExampleLevelArray": {
      "type": "array",
      "description": "One row per level of this dimension.",
      "items": { "$ref": "#/definitions/StyleExampleLevel" }
    },

    "StyleExampleLevel": {
      "type": "object",
      "required": ["level", "examples"],
      "additionalProperties": false,
      "properties": {
        "level": { "type": "string", "description": "Must equal the matching RateRow.level string for this dimension." },
        "n": { "type": ["integer", "null"], "description": "Optional convenience copy of the RateRow.n for this level." },
        "reply_rate": { "type": ["number", "null"], "description": "Optional convenience copy of the RateRow.reply_rate for this level." },
        "meeting_rate": { "type": ["number", "null"], "description": "Optional convenience copy of the RateRow.meeting_rate for this level." },
        "examples": {
          "type": "array",
          "description": "Ordered best-outcome-first; the first item is this level's strongest real example.",
          "items": { "$ref": "#/definitions/StyleExampleItem" }
        }
      }
    },

    "StyleExampleItem": {
      "type": "object",
      "required": ["message", "outcome"],
      "additionalProperties": false,
      "properties": {
        "message": { "type": ["string", "null"], "description": "Real prospect-facing message text (same privacy caveat as top-level examples)." },
        "outcome": { "type": "string", "enum": ["Meeting", "Replied", "Connected", "No response"] },
        "opportunity": { "type": ["number", "null"], "description": "Model-scored opportunity, same scale as top-level examples." }
      }
    },

    "CompanyVsProspect": {
      "type": "object",
      "properties": {
        "avg_pct_about_prospect": { "type": ["number", "null"] },
        "avg_pct_about_us": { "type": ["number", "null"] },
        "by_focus_bucket": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bucket": { "type": "string", "description": "0-25% | 26-50% | 51-75% | 76-100%" },
              "n": { "type": "integer" },
              "reply_rate": { "type": ["number", "null"] },
              "meeting_rate": { "type": ["number", "null"] }
            }
          }
        }
      }
    },

    "AiFeel": {
      "type": "object",
      "properties": {
        "avg_ai_score": { "type": ["number", "null"], "description": "1 = clearly human ... 5 = obviously AI." },
        "by_ai_score": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ai_score": { "type": "integer", "minimum": 1, "maximum": 5 },
              "n": { "type": "integer" },
              "reply_rate": { "type": ["number", "null"] },
              "meeting_rate": { "type": ["number", "null"] }
            }
          }
        }
      }
    },

    "TopPhrases": {
      "type": "object",
      "description": "Phrases surfaced because they move the reply rate (connection-controlled).",
      "required": ["working", "not_working"],
      "additionalProperties": false,
      "properties": {
        "working": { "type": "array", "items": { "$ref": "#/definitions/TopPhraseItem" } },
        "not_working": { "type": "array", "items": { "$ref": "#/definitions/TopPhraseItem" } }
      }
    },

    "TopPhraseItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phrase": { "type": "string" },
        "n": { "type": "integer", "description": "Messages containing the phrase." },
        "reply_rate_with": { "type": ["number", "null"] },
        "reply_rate_without": { "type": ["number", "null"] },
        "effect_pp": { "type": ["number", "null"], "description": "Connection-controlled reply-rate lift (percentage points)." },
        "connection_controlled": { "type": ["boolean", "null"] },
        "p_value": { "type": ["number", "null"] }
      }
    },

    "KeyPhrases": {
      "type": "object",
      "description": "The multi-word phrases used most often, deduped to distinct phrases and tagged by intent.",
      "properties": {
        "opening": { "type": "array", "items": { "$ref": "#/definitions/KeyPhraseItem" } },
        "followup": { "type": "array", "items": { "$ref": "#/definitions/KeyPhraseItem" } }
      }
    },

    "KeyPhraseItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phrase": { "type": "string" },
        "count": { "type": "integer", "description": "Messages containing the phrase." },
        "pct_of_messages": { "type": ["number", "null"], "description": "Share of messages in scope that use it." },
        "category": {
          "type": "string",
          "enum": ["Meeting ask", "About the prospect", "About us", "Compliment / reaction", "Gratitude", "Other"]
        },
        "lift_pp": { "type": ["number", "null"], "description": "Connection-controlled effect on lift_outcome (percentage points)." },
        "lift_outcome": { "type": "string", "enum": ["reply", "meeting"] },
        "connection_controlled": { "type": ["boolean", "null"] }
      }
    },

    "FollowupBlock": {
      "type": "object",
      "properties": {
        "n_replied": { "type": "integer" },
        "avg_reply_enthusiasm": { "type": ["number", "null"], "description": "Warmth of prospect's reply, 1-5." },
        "by_approach": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "approach": { "type": "string" },
              "n": { "type": "integer" },
              "meeting_rate": { "type": ["number", "null"] }
            }
          }
        },
        "by_speed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "speed": { "type": "string" },
              "n": { "type": "integer" },
              "meeting_rate": { "type": ["number", "null"] }
            }
          }
        },
        "by_reply_length": { "type": "array", "items": { "$ref": "#/definitions/RateRow" } }
      }
    },

    "Examples": {
      "type": "object",
      "description": "Real contact names and message text (truncated to 500 chars). Handle per client privacy.",
      "required": ["meetings_won", "high_potential_open"],
      "additionalProperties": false,
      "properties": {
        "meetings_won": { "type": "array", "items": { "$ref": "#/definitions/ExampleItem" } },
        "high_potential_open": { "type": "array", "items": { "$ref": "#/definitions/ExampleItem" } }
      }
    },

    "ExampleItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contact": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "company": { "type": ["string", "null"] },
        "message_type": { "type": ["string", "null"] },
        "opportunity": { "type": ["number", "null"], "description": "Model-scored opportunity." },
        "message": { "type": ["string", "null"], "description": "First message, truncated to 500 chars." }
      }
    }
  }
}

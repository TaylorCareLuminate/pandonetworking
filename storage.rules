rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function for authorized ERS users
    function isAuthorizedERSUser() {
      return request.auth != null && 
        (request.auth.token.email.matches('.*@healthluminate\\.com') || 
         request.auth.token.email.matches('.*@careluminate\\.com') ||
         request.auth.token.email.matches('.*@executiveretirementplans\\.com') ||
         request.auth.token.email.matches('.*@outlook\\.com'));
    }
    
    // Allow authenticated users to upload and read project documents
    match /project-documents/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Project request documents for tracking system
    match /projectRequests/{projectId}/{folder}/{filename} {
      allow read: if isAuthorizedERSUser();
      allow write: if isAuthorizedERSUser() &&
        request.resource.size < 50 * 1024 * 1024; // 50MB limit
    }
    
    // CRM Client Documents Storage
    match /ers_client_documents/{clientId}/{filename} {
      // Allow read for authorized users
      allow read: if isAuthorizedERSUser();
      
      // Allow write (upload) for authorized users with file size and type restrictions
      allow write: if isAuthorizedERSUser() &&
        request.resource.size < 50 * 1024 * 1024 && // 50MB limit
        request.resource.contentType.matches('application/pdf|application/msword|application/vnd.*|image/.*|text/.*');
      
      // Allow delete for authorized users
      allow delete: if isAuthorizedERSUser();
    }
    
    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
} 
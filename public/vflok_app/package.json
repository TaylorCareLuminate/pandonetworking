{
  "name": "vflok-hospital-dashboard",
  "productName": "vFlok Hospital Dashboard",
  "version": "1.3.17",
  "description": "Healthcare Analytics Desktop Application with local SQLite database",
  "main": "main.js",
  "author": {
    "name": "vFlok",
    "email": "support@vflok.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "npx electron .",
    "dev": "npx electron . --dev",
    "build": "npx electron-builder",
    "build:win": "npx electron-builder --win",
    "build:mac": "npx electron-builder --mac",
    "build:all": "npx electron-builder --win --mac",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist node_modules",
    "rebuild": "npm run clean && npm install"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vflok.hospital-dashboard",
    "productName": "vFlok Hospital Dashboard",
    "copyright": "Copyright \u00a9 2026 vFlok",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "database/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "database/vflok_hospitals.db",
        "to": "database/vflok_hospitals.db"
      },
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql.js/sql-wasm.wasm"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "publish": {
        "provider": "generic",
        "url": "https://yourdomain.com/downloads/"
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.business",
      "artifactName": "${productName}-${version}.${ext}",
      "publish": {
        "provider": "generic",
        "url": "https://yourdomain.com/downloads/"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "vFlok Hospital Dashboard"
    },
    "publish": {
      "provider": "generic",
      "url": "https://yourdomain.com/downloads/"
    }
  }
}

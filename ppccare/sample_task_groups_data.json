  "group_001": {
    "groupId": "group_001",
    "name": "Customer Onboarding Process",
    "type": "Customer Support",
    "description": "Complete workflow for onboarding new healthcare customers, including documentation, setup, and training phases.",
    "rootTaskIndex": 0,
    "tasks": [
      {
        "name": "Initial customer consultation",
        "daysAfterRoot": 0,
        "assignedTo": "IT Director",
        "checklistItems": [
          "Schedule initial meeting with customer",
          "Gather customer requirements and expectations",
          "Present system overview and capabilities",
          "Collect signed agreements and contracts",
          "Document customer-specific needs"
        ]
      },
      {
        "name": "Technical requirements gathering",
        "daysAfterRoot": 1,
        "assignedTo": "EHR Administrator",
        "checklistItems": [
          "Review customer's current IT infrastructure",
          "Analyze EHR system compatibility",
          "Document integration requirements",
          "Create technical implementation plan",
          "Identify potential technical challenges"
        ]
      },
      {
        "name": "System configuration coordination",
        "daysAfterRoot": 3,
        "assignedTo": "Practice Manager",
        "checklistItems": [
          "Configure customer environment",
          "Set up user accounts and permissions",
          "Configure system settings per requirements",
          "Establish data migration protocols",
          "Test basic system functionality"
        ]
      },
      {
        "name": "Data migration oversight",
        "daysAfterRoot": 7,
        "assignedTo": "Quality Assurance Manager",
        "checklistItems": [
          "Extract data from legacy systems",
          "Transform data to new format",
          "Load data into new system",
          "Validate data accuracy and completeness",
          "Perform integration testing with customer"
        ]
      },
      {
        "name": "User training coordination",
        "daysAfterRoot": 10,
        "assignedTo": "Training Coordinator",
        "checklistItems": [
          "Prepare customized training materials",
          "Schedule training sessions with user groups",
          "Conduct administrator training",
          "Conduct end-user training",
          "Provide training documentation and resources"
        ]
      },
      {
        "name": "Go-live support coordination",
        "daysAfterRoot": 14,
        "assignedTo": "Clinical Workflow Coordinator",
        "checklistItems": [
          "Monitor system performance during go-live",
          "Provide immediate technical support",
          "Address any urgent issues",
          "Collect feedback from users",
          "Document lessons learned and improvements"
        ]
      }
    ],
    "createdDate": "2024-01-15T09:30:00Z",
    "createdBy": "sarah.johnson@highspring.com",
    "lastUpdated": "2024-01-20T14:15:00Z",
    "updatedBy": "sarah.johnson@highspring.com"
  },
  "group_002": {
    "groupId": "group_002",
    "name": "EHR System Integration",
    "type": "Consultant Support",
    "description": "Technical workflow for integrating Electronic Health Record systems with our platform, including API setup and testing.",
    "rootTaskIndex": 0,
    "tasks": [
      {
        "name": "API credentials and access setup",
        "daysAfterRoot": 0,
        "assignedTo": "Technical Integration Specialist",
        "checklistItems": [
          "Obtain API credentials from EHR vendor",
          "Set up secure connection protocols",
          "Configure authentication mechanisms",
          "Test initial API connectivity",
          "Document connection parameters"
        ]
      },
      {
        "name": "Data mapping and transformation",
        "daysAfterRoot": 2,
        "assignedTo": "Data Migration Specialist",
        "checklistItems": [
          "Map EHR data fields to our system",
          "Create data transformation rules",
          "Handle data type conversions",
          "Set up data validation rules",
          "Test mapping with sample data"
        ]
      },
      {
        "name": "Integration testing and validation",
        "daysAfterRoot": 5,
        "assignedTo": "Quality Assurance Consultant",
        "checklistItems": [
          "Perform end-to-end integration testing",
          "Validate data accuracy and completeness",
          "Test error handling and recovery",
          "Perform load testing",
          "Generate integration test report"
        ]
      },
      {
        "name": "Customer acceptance testing coordination",
        "daysAfterRoot": 7,
        "assignedTo": "Customer Success Manager",
        "checklistItems": [
          "Coordinate with customer technical team",
          "Set up customer testing environment",
          "Guide customer through testing process",
          "Document customer feedback and issues",
          "Obtain customer sign-off on integration"
        ]
      }
    ],
    "createdDate": "2024-01-18T11:45:00Z",
    "createdBy": "david.wilson@highspring.com",
    "lastUpdated": "2024-01-18T11:45:00Z",
    "updatedBy": "david.wilson@highspring.com"
  },

{
  "rules": {
    "hccrm": {
      "leads": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$leadId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "index": {
        "domains": {
          ".indexOn": ["domain"],
          ".read": "auth != null",
          ".write": "auth != null",
          "$domainId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },
        "organizations": {
          ".indexOn": ["organizationName", "domain"],
          ".read": "auth != null",
          ".write": "auth != null",
          "$orgId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    },
    "cl": {
      "financial_forecast": {
        ".read": "auth != null && (auth.token.email.endsWith('@healthluminate.com') || auth.token.email.endsWith('@careluminate.com'))",
        ".write": "auth != null && (auth.token.email.endsWith('@healthluminate.com') || auth.token.email.endsWith('@careluminate.com'))",
        "$forecastId": {
          ".read": "auth != null && (auth.token.email.endsWith('@healthluminate.com') || auth.token.email.endsWith('@careluminate.com'))",
          ".write": "auth != null && (auth.token.email.endsWith('@healthluminate.com') || auth.token.email.endsWith('@careluminate.com'))"
        }
      }
    },
    "market_share_providers": {
      ".read": "auth != null && (auth.token.email.endsWith('@healthluminate.com') || auth.token.email.endsWith('@careluminate.com'))",
      ".write": "auth != null && (auth.token.email.endsWith('@healthluminate.com') || auth.token.email.endsWith('@careluminate.com'))",
      "allvends": {
        ".read": "auth != null && (auth.token.email.endsWith('@healthluminate.com') || auth.token.email.endsWith('@careluminate.com'))",
        ".write": "auth != null && (auth.token.email.endsWith('@healthluminate.com') || auth.token.email.endsWith('@careluminate.com'))",
        "$vendorId": {
          ".read": "auth != null && (auth.token.email.endsWith('@healthluminate.com') || auth.token.email.endsWith('@careluminate.com'))",
          ".write": "auth != null && (auth.token.email.endsWith('@healthluminate.com') || auth.token.email.endsWith('@careluminate.com'))"
        }
      }
    }
  }
} 
// Javascript for changing things in the Swagger generated documentation

// It takes the document a sec to load the swagger stuff loop until we find it
var checkExist = setInterval(function () {
    if (document.getElementsByClassName("info__license").length > 0 ) {
        clearInterval(checkExist);

        // Appending the HowToUse section
        var info = document.getElementsByClassName('info')[0];
        var howToUse = document.getElementById('howToUse');
        var howToUseToggler = document.getElementById('toggleHowToUse');
        var howToUseInfo = document.getElementById('howToUseInfo');

        info.appendChild(howToUse);
        howToUse.style.display = "block";

        howToUseToggler.onclick = function () {
            var display = howToUseInfo.style.display;
            if (display == "none") {
                howToUseInfo.style.display = "block";
            } else {
                howToUseInfo.style.display = "none";
            }
        }       
    }

    document.addEventListener('click', function (e) {
        // Check if the clicked element is the Reset button
        if (e.target.className == 'btn try-out__btn reset') {

            // Find the parent operation block for this Reset button
            const opblock = e.target.closest('.opblock') || document;

            opblock.querySelectorAll('input[type="file"]').forEach(input => {
                input.value = '';
            });
        }
    });
}, 100); // check every 100ms


